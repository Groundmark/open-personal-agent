# Vaultwarden for the agent's logins: loopback only, never published. Copy to vaultwarden.env (kept out of git).
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=8222
DOMAIN=https://127.0.0.1:8222
# HTTPS on loopback, because the bw CLI refuses plain HTTP; its own certificate (made by install.sh), trusted only by the broker's bw.
ROCKET_TLS={certs="/etc/opa/vault-tls/cert.pem",key="/etc/opa/vault-tls/key.pem"}
DATA_FOLDER=/var/lib/opa/vault
WEB_VAULT_FOLDER=/opt/vaultwarden/web-vault
WEB_VAULT_ENABLED=true
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false
