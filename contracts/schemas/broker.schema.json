{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Groundmark/open-personal-agent/contracts/schemas/broker.schema.json",
  "title": "Broker: credentials, grants, identity (0.4-draft)",
  "$defs": {
    "grant_state": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "consumed",
        "revoked"
      ]
    },
    "book_constraints": {
      "type": "object",
      "properties": {
        "venue": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "time": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "party_size": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "venue",
        "date",
        "time",
        "party_size"
      ]
    },
    "grant.request.args": {
      "type": "object",
      "properties": {
        "credential": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/credential_by_site"
            }
          ]
        },
        "ops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "read",
              "search",
              "login",
              "book",
              "edit_order",
              "pay"
            ]
          }
        },
        "constraints": {
          "type": "object"
        },
        "mode": {
          "enum": [
            "standing",
            "one_shot"
          ]
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "purpose": {
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/operator_session"
        },
        "operator_present": {
          "type": "boolean",
          "default": false
        },
        "call": {
          "description": "For a binding op on a credential with more than one tool that could make the act: the one call the grant allows. The broker fixes the call (and, for a relying party, the exact HTTP request) when the grant is created, and the passkey approves it.",
          "type": "object",
          "properties": {
            "server": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            }
          },
          "required": [
            "server",
            "tool"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ops",
        "constraints",
        "mode",
        "ttl_seconds",
        "purpose"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "ops": {
                "contains": {
                  "const": "book"
                }
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "one_shot"
              },
              "ttl_seconds": {
                "maximum": 3600
              },
              "constraints": {
                "$ref": "#/$defs/book_constraints"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ops": {
                "contains": {
                  "const": "edit_order"
                }
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "one_shot"
              },
              "ttl_seconds": {
                "maximum": 3600
              },
              "constraints": {
                "$ref": "#/$defs/edit_order_constraints"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ops": {
                "contains": {
                  "const": "pay"
                }
              }
            }
          },
          "then": {
            "properties": {
              "mode": {
                "const": "one_shot"
              },
              "ttl_seconds": {
                "maximum": 3600
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "required": [
            "credential"
          ],
          "not": {
            "required": [
              "session"
            ]
          }
        },
        {
          "required": [
            "session"
          ],
          "not": {
            "required": [
              "credential"
            ]
          }
        }
      ]
    },
    "grant.request.result": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "state": {
          "const": "pending"
        },
        "approve_url": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string"
        },
        "credential_ref": {
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/exact_request"
        }
      },
      "required": [
        "grant_id",
        "state",
        "approve_url",
        "summary"
      ]
    },
    "grant.status.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "grant_id"
      ]
    },
    "grant.status.result": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "denied",
            "expired",
            "consumed",
            "revoked"
          ]
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "uses": {
          "type": "integer",
          "minimum": 0
        },
        "last_used_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "$ref": "#/$defs/exact_request"
        }
      },
      "required": [
        "grant_id",
        "state",
        "uses"
      ]
    },
    "grant.revoke.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "grant_id"
      ]
    },
    "grant.revoke.result": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "state": {
          "const": "revoked"
        }
      },
      "required": [
        "grant_id",
        "state"
      ]
    },
    "mcp.call.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "server": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        }
      },
      "required": [
        "grant_id",
        "server",
        "tool",
        "arguments"
      ]
    },
    "mcp.call.result": {
      "type": "object",
      "properties": {
        "content": {}
      },
      "required": [
        "content"
      ]
    },
    "identity.declaration.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "act": {
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "act"
      ],
      "additionalProperties": false
    },
    "identity.declaration.result": {
      "type": "object",
      "properties": {
        "declaration": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string"
            },
            "operator": {
              "type": "string"
            },
            "agent_kid": {
              "type": "string"
            },
            "relying_party": {
              "type": "string"
            },
            "act": {
              "type": "string"
            },
            "grant_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "constraints": {
              "description": "The grant's constraints, as approved.",
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ts": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "format",
            "agent_kid",
            "relying_party",
            "act",
            "grant_id",
            "ts"
          ]
        },
        "kid": {
          "type": "string"
        },
        "sig_b64": {
          "type": "string"
        },
        "presented": {
          "type": "boolean"
        }
      },
      "required": [
        "declaration",
        "kid",
        "sig_b64",
        "presented"
      ]
    },
    "status.result": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "store": {
          "type": "string"
        },
        "agent_kid": {
          "type": "string"
        },
        "broker_kid": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "store",
        "agent_kid",
        "broker_kid"
      ]
    },
    "edit_order_constraints": {
      "type": "object",
      "properties": {
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "item",
                  "quantity"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "skip": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "skip"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "changes"
      ]
    },
    "operator_session": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "format": "uri"
        },
        "browser": {
          "const": "operator"
        }
      },
      "required": [
        "origin",
        "browser"
      ]
    },
    "errors": {
      "enum": [
        "grant_not_found",
        "grant_not_approved",
        "grant_denied",
        "grant_expired",
        "grant_revoked",
        "grant_consumed",
        "op_not_granted",
        "constraint_mismatch",
        "one_shot_required",
        "origin_mismatch",
        "credential_not_found",
        "credential_ambiguous",
        "store_unavailable",
        "code_timeout",
        "store_needs_operator",
        "store_no_answer",
        "upstream_error",
        "approval_timeout"
      ]
    },
    "credential_by_site": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "username": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "domain"
      ],
      "additionalProperties": false
    },
    "code.deliver.args": {
      "type": "object",
      "properties": {
        "slot_id": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{4,10}$"
        }
      },
      "required": [
        "slot_id",
        "code"
      ],
      "additionalProperties": false
    },
    "code.deliver.result": {
      "type": "object",
      "properties": {
        "accepted": {
          "const": true
        }
      },
      "required": [
        "accepted"
      ]
    },
    "code.slots.args": {
      "type": "object",
      "properties": {
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60,
          "default": 50
        },
        "cursor": {
          "type": "string",
          "description": "Opaque: the cursor the last code.slots result gave. Only slots opened after it are listed."
        }
      },
      "additionalProperties": false
    },
    "code.slots.result": {
      "type": "object",
      "properties": {
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code_slot"
          }
        },
        "cursor": {
          "type": "string",
          "description": "Pass it back on the next call."
        }
      },
      "required": [
        "slots",
        "cursor"
      ]
    },
    "exact_request": {
      "description": "The one call a binding grant allows, fixed when the grant is created and covered by the passkey. method, url and content_digest are present when the tool is a relying party the broker reaches over HTTP and signs as the agent.",
      "type": "object",
      "properties": {
        "server": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "content_digest": {
          "type": "string",
          "description": "RFC 9530 Content-Digest of the body, e.g. sha-256=:...:"
        }
      },
      "required": [
        "server",
        "tool"
      ]
    },
    "code_slot": {
      "description": "A code slot the broker has open for this channel adapter: returned by code.slots on that adapter's socket.",
      "type": "object",
      "properties": {
        "slot_id": {
          "type": "string"
        },
        "account_id": {
          "type": "string",
          "description": "The paired account the code is for, where the broker knows it. With one paired person it may be left out."
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slot_id",
        "expires_at"
      ]
    },
    "credential_ambiguous.detail": {
      "type": "object",
      "properties": {
        "usernames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "usernames"
      ]
    }
  }
}
