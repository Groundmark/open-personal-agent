{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Groundmark/open-personal-agent/contracts/schemas/router.schema.json",
  "title": "Router: inference (0.1-draft)",
  "$defs": {
    "part": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tool_call"
            },
            "call_id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            }
          },
          "required": [
            "type",
            "call_id",
            "name",
            "arguments"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tool_result"
            },
            "call_id": {
              "type": "string"
            },
            "content": {},
            "is_error": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "call_id",
            "content"
          ]
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant",
            "tool"
          ]
        },
        "content": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/part"
              }
            }
          ]
        }
      },
      "required": [
        "role",
        "content"
      ]
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "description",
        "parameters"
      ]
    },
    "infer.args": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "model",
        "messages"
      ]
    },
    "infer.result": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part"
          }
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "call_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "arguments": {
                "type": "object"
              }
            },
            "required": [
              "call_id",
              "name",
              "arguments"
            ]
          }
        },
        "stop": {
          "enum": [
            "end",
            "tool_calls",
            "max_tokens",
            "refused"
          ]
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer"
            },
            "output_tokens": {
              "type": "integer"
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ]
        },
        "served_by": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "content",
        "tool_calls",
        "stop",
        "usage"
      ]
    },
    "errors": {
      "enum": [
        "unknown_model",
        "provider_error",
        "rate_limited",
        "context_too_long",
        "credential_unavailable"
      ]
    }
  }
}
