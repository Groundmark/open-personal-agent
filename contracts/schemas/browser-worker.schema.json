{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Groundmark/open-personal-agent/contracts/schemas/browser-worker.schema.json",
  "title": "Browser worker (0.2-draft)",
  "$defs": {
    "page": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "screenshot_png_b64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "url",
        "title",
        "text"
      ]
    },
    "browser.open.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "read_only": {
          "type": "boolean"
        }
      },
      "required": [
        "grant_id",
        "url"
      ]
    },
    "browser.open.result": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "page": {
          "$ref": "#/$defs/page"
        }
      },
      "required": [
        "session_id",
        "page"
      ]
    },
    "browser.act.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "session_id": {
          "type": "string"
        },
        "action": {
          "enum": [
            "click",
            "type",
            "select",
            "scroll",
            "wait"
          ]
        },
        "target": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "book_grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "grant_id",
        "session_id",
        "action",
        "target"
      ]
    },
    "browser.act.result": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/$defs/page"
        }
      },
      "required": [
        "page"
      ]
    },
    "browser.fill_login.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "session_id": {
          "type": "string"
        },
        "credential": {
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "session_id"
      ],
      "description": "credential is required for a grant on a named credential; omit it for a credential-by-site grant (the broker uses the grant's item)."
    },
    "browser.fill_login.result": {
      "type": "object",
      "properties": {
        "filled": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "filled"
      ]
    },
    "browser.close.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "session_id"
      ]
    },
    "browser.close.result": {
      "type": "object",
      "properties": {}
    },
    "browser.extract.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "session_id": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "grant_id",
        "session_id",
        "target"
      ]
    },
    "browser.extract.result": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/$defs/page"
        }
      },
      "required": [
        "page"
      ]
    },
    "browser.await_login.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "session_id": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      },
      "required": [
        "grant_id",
        "session_id",
        "timeout_seconds"
      ]
    },
    "browser.await_login.result": {
      "type": "object",
      "properties": {
        "logged_in": {
          "const": true
        },
        "login_mode": {
          "const": "operator_filled"
        }
      },
      "required": [
        "logged_in",
        "login_mode"
      ]
    },
    "errors": {
      "enum": [
        "session_not_found",
        "navigation_failed",
        "blocked_by_site",
        "target_not_found",
        "origin_mismatch",
        "secret_value_refused",
        "constraint_mismatch",
        "unauthorized_caller",
        "read_only_session",
        "login_timeout"
      ]
    },
    "browser.fill_code.args": {
      "type": "object",
      "properties": {
        "grant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "session_id": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{4,10}$"
        },
        "source": {
          "enum": [
            "store_totp",
            "person"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      },
      "required": [
        "grant_id",
        "session_id"
      ],
      "description": "Core to broker: { grant_id, session_id, source, timeout_seconds? }. Broker to worker: { grant_id, session_id, code }.",
      "oneOf": [
        {
          "required": [
            "source"
          ],
          "not": {
            "required": [
              "code"
            ]
          }
        },
        {
          "required": [
            "code"
          ],
          "not": {
            "required": [
              "source"
            ]
          }
        }
      ]
    },
    "browser.fill_code.result": {
      "type": "object",
      "properties": {
        "filled": {
          "const": true
        }
      },
      "required": [
        "filled"
      ]
    }
  }
}
